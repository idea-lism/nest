# a line of comment starts with "#"

# VPA section
[[vpa]]

# some tokens are essential to source code layout, but noise to AST.
# with %ignore we can re-construct the source without losing non-semantic tokens
%ignore @comment @space

# pre-define partial regexp for later use
%define ID /[a-z_]\w*/

# declare a custom decision hook that can yield a bitset of the decisions (in declaration order)
# if the custom hook returns 0, that will be no-op
%effect .str_check_end = @char | .end

# when used in editor, scopes are auto-foldable and can be selected with text object commands
main = {
  vpa
  ll
  *noise
  EOF .end
}

*noise = {
  /#[^\n]*/ @comment
  /[ \t]+/ @space
  /\n+/ @nl
}

*directive_keywords = @{
  "%ignore"
  "%effect"
  "%define"
  "="
  "|"
}

vpa = /\s*\[\[vpa\]\]\n/ .begin {
  /\[\[ll\]\]/ .unparse .end
  *directive_keywords
  *vpa_commons
  scope
  lit_scope
  *noise
}

*vpa_commons = {
  /\.begin/ @hook_begin
  /\.end/ @hook_end
  /\.fail/ @hook_fail
  /\.unparse/ @hook_unparse
  ID @vpa_id
  "EOF" @pseudo_frag_eof
  /[A-Z]\w*/ @re_frag_id
  /\*#{ID}/ @module_id
  /\.#{ID}/ @user_hook_id
  /\@#{ID}/ @tok_id
  re
  re_str
}

scope = "{" .begin {
  *vpa_commons
  "-" @re_reverse_start
  "}" .end
  *noise
}

lit_scope = "@{" .begin {
  re_str
  "}" .end
  *noise
}

*ll_ops = @{
  "<"
  ">"
  "?"
  "+"
  "*"
}

ll = /\s*\[\[ll\]\]\n/ .begin {
  "=" @ll_assign
  "TODO" @ll_todo
  *ll_commons
  branches
  *noise
  EOF .end
}

*ll_commons = {
  /[a-z_]\w*/ @ll_id
  /\@#{ID}/ @ll_tok_id
  ll_str
  *ll_ops
  *noise
}

branches = "[" .begin {
  *ll_commons
  ll_tag
  "]" .end
  *noise
}

# to make it simpler, tag_id must appear on the same line after colon, or it may eat the rest of the branches
ll_tag = /:/ .begin {
  ID @tag_id
  /\n/ .end @nl
  *noise
}

*re_ops = @{
  "|"
  "("
  ")"
  "?"
  "+"
  "*"
}

re = /(b|i|ib|bi)?\// .set_re_mode .begin {
  /\// .end
  charclass
  /\./ @re_dot
  /\\s/ @re_space_class
  /\\w/ @re_word_class
  /\\d/ @re_digit_class
  /\\h/ @re_hex_class
  re_ref
  *re_ops
  *chars
}

re_ref = /\\\{/ .begin {
  /[A-Z]\w*/ @re_ref
  /\}/ .end
}

charclass = /\[\^?/ .set_cc_kind .begin {
  "/" .unparse .end # populate error to regexp
  /\]/ .end
  /-/ @range_sep
  *chars
}

*chars = {
  /\\\{\h+\}/ @codepoint
  /\\[bfnrtv]/ @c_escape
  /\\./ @plain_escape
  /./ @char
}

re_str = /["']/ .set_quote .begin {
  /["']/ .str_check_end # may emit char or terminate matching
  *chars
}

# same as re_str, but the parsing process is different so we create different scope
ll_str = /["']/ .set_quote .begin {
  /["']/ .str_check_end # may emit char or terminate matching
  *chars
}

# parser section
[[ll]]

main = vpa ll

### VPA rules

vpa = @nl* vpa_line+<@nl> @nl*

vpa_line = [ # branches
  ignore_toks
  effect_spec
  define_frag
  vpa_rule
  vpa_module_rule
]

ignore_toks = "%ignore" @tok_id+

effect_spec = "%effect" @user_hook_id "=" effect+<"|">

effect = [
  @tok_id
  @hook_begin
  @hook_end
  @hook_fail
  @hook_unparse
]

define_frag = "%define" @re_frag_id re

vpa_rule = @vpa_id "=" [
  re
  re_str
  @pseudo_frag_eof
  @re_frag_id
] action* scope?

vpa_module_rule = [
  @module_id "=" scope
  @module_id "=" lit_scope
]

action = [
  @tok_id
  @hook_begin
  @hook_end
  @hook_fail
  @hook_unparse
  @user_hook_id
]

# surroundings already trimmed by lexer
scope = @nl* scope_line+<@nl> @nl*

lit_scope = @nl* re_str+<@nl> @nl*

scope_line = [
  re re_reverse? action*
  re_str re_reverse? action*
  @pseudo_frag_eof action*
  @re_frag_id re_reverse? action*
  @vpa_id action*
  @module_id
]

### Regex AST rules

# move cursor back by reverse-parsing a regexp
re_reverse = @re_reverse_start [
  re
  re_str
  @re_frag_id
]

re = re_quantified+<"|">

re_quantified = re_unit [
  "?" : maybe
  "+" : plus
  "*" : star
  : unquantified
]

re_unit = [
  "(" re ")"
  charclass
  @re_dot
  @re_space_class
  @re_word_class
  @re_digit_class
  @re_hex_class
  @re_ref
  @char
  @codepoint
  @c_escape
  @plain_escape
]

charclass = @charclass_begin charclass_unit+

charclass_unit = [
  charclass_char @range_sep charclass_char : range
  charclass_char : single
]

charclass_char = [
  @codepoint
  @c_escape
  @plain_escape
  @char
]

re_str = str_char*

str_char = [
  @char
  @codepoint
  @c_escape
  @plain_escape
]

### LL rules

ll = @nl* ll_rule+<@nl> @nl*

ll_rule = @ll_id @ll_assign [
  @ll_todo
  seq
]

seq = ll_unit+

ll_unit = [
  @ll_id multiplier?
  @ll_tok_id multiplier?
  ll_str multiplier?
  branches
]

ll_simple_unit = [
  @ll_id multiplier?
  @ll_tok_id multiplier?
  ll_str multiplier?
]

ll_str = str_char*

multiplier = [
  "?"
  "+" interlace?
  "*" interlace?
]

interlace_rhs = [
  @ll_id
  @ll_tok_id
  ll_str
]

# multipliers can't nest
interlace = "<" interlace_rhs ">"

# lexer already trimmed surroundings
# scope makes it easy parsable
branches = @nl* branch_line+<@nl> @nl*

# branch can't nest
branch_line = [
  ll_simple_unit+ @tag_id?
  @tag_id
]
